  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// This collection intentionally ignores environments, including a stale selected environment.",
          "const BASE=\"https://payment-frontend-52916499838.us-central1.run.app/api/v1\";",
          "const routes={\"Login existing demo customer\": \"/auth/login\", \"Login existing receiver\": \"/auth/login\", \"Register a new sandbox customer and bank account\": \"/auth/register\", \"Login the registered customer\": \"/auth/login\", \"My existing profile\": \"/customers/{{live_sender_customer_id}}\", \"My current balance\": \"/wallet\", \"My real bank activity\": \"/wallet/activity?page=0&size=20\", \"My payment history\": \"/payments?page=0&size=20\", \"Retrieve latest payment by ID\": \"/payments/{{live_payment_id}}\", \"Retrieve seeded refund\": \"/payments/{{live_refund_payment_id}}/refund\", \"My outgoing transfers\": \"/transfers?page=0&size=20\", \"Retrieve latest transfer by ID\": \"/transfers/{{live_transfer_id}}\", \"My money requests\": \"/money-requests?page=0&size=20\", \"My notifications\": \"/notifications?page=0&size=20\", \"Receiver: current balance\": \"/wallet\", \"Lookup receiver account\": \"/wallet/recipients/{{live_receiver_account}}\", \"Add INR 10 demo money\": \"/wallet/deposits\", \"Receiver: add INR 10 demo money\": \"/wallet/deposits\", \"Create INR 2 merchant payment\": \"/payments\", \"Fetch the payment just created\": \"/payments/{{live_payment_id}}\", \"Create INR 1 transfer to receiver\": \"/transfers\", \"Fetch the transfer just created\": \"/transfers/{{live_transfer_id}}\", \"Create INR 1 money request\": \"/money-requests\", \"Receiver: pay latest money request\": \"/money-requests/{{live_request_id}}/pay\", \"Refund latest merchant payment\": \"/payments/{{live_payment_id}}/refunds\", \"Fetch refund just created\": \"/payments/{{live_payment_id}}/refund\", \"Fetch updated balance\": \"/wallet\", \"Fetch updated activity\": \"/wallet/activity?page=0&size=20\", \"Fetch updated payment history\": \"/payments?page=0&size=20\", \"Fetch updated transfers\": \"/transfers?page=0&size=20\", \"Fetch updated money requests\": \"/money-requests?page=0&size=20\"};",
          "const actors={sender:{username:'demo',password:'demo123',name:'Demo User',email:'demo@example.com'},receiver:{username:'receiver',password:'receiver123',name:'Receiver User',email:'receiver@example.com'}};",
          "const requestedTrace=pm.variables.replaceIn('{{$guid}}').replace(/-/g,'');",
          "pm.variables.set('otel_requested_trace_id',requestedTrace);",
          "pm.request.headers.upsert({key:'traceparent',value:'00-'+requestedTrace+'-'+pm.variables.replaceIn('{{$guid}}').replace(/-/g,'').slice(0,16)+'-01'});",
          "function stop(message){if(pm.execution && pm.execution.skipRequest)pm.execution.skipRequest();throw new Error(message);}",
          "function call(path,body,token,done,attempt=0){",
          " const headers={'Content-Type':'application/json'};if(token)headers.Authorization='Bearer '+token;",
          " pm.sendRequest({url:BASE+path,method:body===null?'GET':'POST',header:headers,...(body===null?{}:{body:{mode:'raw',raw:JSON.stringify(body)}})},(error,response)=>{",
          "   // Only reads and login are retried. Registration/money operations are never blindly retried.",
          "   if((body===null || path==='/auth/login') && (error || [429,502,503,504].includes(response.code)) && attempt<2){setTimeout(()=>call(path,body,token,done,attempt+1),1000);return;}",
          "   if(error)return stop('Unable to reach the deployed frontend. Check Postman Console/TLS/network; the business request was skipped.');",
          "   done(response);",
          " });",
          "}",
          "function ensure(who,done){",
          " const actor=actors[who];",
          " function profile(session){",
          "   call('/customers/'+session.customerId,null,session.accessToken,response=>{",
          "     if(response.code!==200)return stop('Customer profile unavailable (HTTP '+response.code+'). Business request skipped.');",
          "     const data=response.json();pm.collectionVariables.set('live_'+who+'_customer_id',session.customerId);pm.collectionVariables.set('live_'+who+'_account',data.accountNumber);done(session.accessToken);",
          "   });",
          " }",
          " call('/auth/login',{username:actor.username,password:actor.password},null,response=>{",
          "   if(response.code===200)return profile(response.json());",
          "   if(response.code!==401)return stop('Sandbox login failed (HTTP '+response.code+'). Business request skipped.');",
          "   // Fresh database: create this sandbox customer/account, then use its actual assigned account.",
          "   call('/auth/register',actor,null,created=>{",
          "     if(created.code!==200)return stop('Sandbox account setup returned HTTP '+created.code+'. Retry the same request after checking the response; no money request was sent.');",
          "     call('/auth/login',{username:actor.username,password:actor.password},null,logged=>{if(logged.code!==200)return stop('New sandbox account login failed.');profile(logged.json());});",
          "   });",
          " });",
          "}",
          "const path=routes[pm.info.requestName];",
          "if(path.startsWith('/auth/')){pm.request.url.update(BASE+path);}",
          "else ensure('sender',sender=>ensure('receiver',receiver=>{",
          " const route=path.replace(/{{(w+)}}/g,(_,key)=>{const value=pm.collectionVariables.get(key);if(!value)return stop('Missing saved record '+key+'. Run the create requests first.');return encodeURIComponent(value);});",
          " pm.request.url.update(BASE+route);",
          " pm.request.headers.upsert({key:'Authorization',value:'Bearer '+(pm.info.requestName.startsWith('Receiver:')?receiver:sender)});",
          " if(pm.request.body && pm.request.body.raw){",
          "   const body=JSON.parse(pm.request.body.raw);",
          "   if('accountNumber' in body)body.accountNumber=pm.collectionVariables.get('live_sender_account');",
          "   if('senderAccount' in body)body.senderAccount=pm.collectionVariables.get('live_sender_account');",
          "   if('receiverAccount' in body)body.receiverAccount=pm.collectionVariables.get('live_receiver_account');",
          "   if('payerAccount' in body)body.payerAccount=pm.collectionVariables.get('live_receiver_account');",
          "   pm.request.body.update(JSON.stringify(body,null,2));",
          " }",
          "}));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const project=pm.collectionVariables.get('gcp_project_id') || '';",
          "const reportedTrace=pm.response.headers.get('X-Trace-Id') || '';",
          "const correlation=pm.response.headers.get('X-Correlation-Id') || '';",
          "const validTrace=/^[a-f0-9]{32}$/i.test(reportedTrace) && !/^0+$/.test(reportedTrace);",
          "pm.collectionVariables.set('last_trace_id',validTrace ? reportedTrace : '');",
          "pm.collectionVariables.set('last_correlation_id',/^[A-Za-z0-9._-]{1,100}$/.test(correlation) ? correlation : '');",
          "const validProject=/^[a-z][a-z0-9-]{4,61}[a-z0-9]$/.test(project);",
          "const query=validTrace ? 'trace=\"projects/'+project+'/traces/'+reportedTrace+'\"' : '';",
          "const logsUrl=validProject && validTrace ? 'https://console.cloud.google.com/logs/query?project='+encodeURIComponent(project)+'&query='+encodeURIComponent(query) : '';",
          "const traceUrl=validProject && validTrace ? 'https://console.cloud.google.com/traces/list?project='+encodeURIComponent(project)+'&tid='+reportedTrace : '';",
          "pm.collectionVariables.set('last_logs_url',logsUrl);pm.collectionVariables.set('last_trace_url',traceUrl);",
          "if(String(pm.collectionVariables.get('otel_require_trace'))==='true') {",
          "  pm.test('Gateway reports the accepted OTel trace',()=>pm.expect(reportedTrace).to.eql(pm.variables.get('otel_requested_trace_id')));",
          "}",
          "if(pm.request.method==='POST' && /\\/v1\\/payments$/.test(pm.request.url.getPath()) && pm.response.code===201 && validTrace) {",
          "  const paymentResult=pm.response.json();",
          "  if(pm.collectionVariables.get('otel_payment_id')!==paymentResult.paymentId) {",
          "    pm.collectionVariables.set('otel_payment_id',paymentResult.paymentId);",
          "    pm.collectionVariables.set('otel_payment_trace_id',reportedTrace);",
          "    pm.collectionVariables.set('otel_payment_trace_url',traceUrl);pm.collectionVariables.set('otel_payment_logs_url',logsUrl);",
          "  }",
          "}",
          "pm.visualizer.set('<h3>Request telemetry</h3><p>Trace: {{trace}}</p><p>Correlation: {{correlation}}</p>{{#if traceUrl}}<p><a href=\"{{traceUrl}}\" target=\"_blank\">Open distributed trace</a> | <a href=\"{{logsUrl}}\" target=\"_blank\">Open correlated logs</a></p>{{else}}<p>No active trace reported.</p>{{/if}}<p>Links require your Google Cloud viewing permissions. A returned trace ID does not prove backend storage.</p>',{trace:validTrace ? reportedTrace : 'Not reported',correlation,traceUrl,logsUrl});"
        ]
      }
    }
  ],
