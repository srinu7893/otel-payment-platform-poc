            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{live_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Ready to Send with the Live Data environment. Authentication is automatic. Uses existing persisted sandbox data; no real money.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"{{live_new_deposit_key}}\",\n  \"amount\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
