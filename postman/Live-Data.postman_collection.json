            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{live_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Ready to Send with the Live Data environment. Authentication is automatic. Uses existing persisted sandbox data; no real money.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"{{live_new_request_key}}\",\n  \"payerAccount\": \"{{live_receiver_account}}\",\n  \"amount\": 1,\n  \"note\": \"Postman manual shared coffee\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.environment.set(\"live_request_id\",pm.response.json().id);"
                ]
              }
            }
          ]
        },
