    {
      "title": "Database acquire wait p95",
      "type": "timeseries",
      "description": "Connection acquisition wait, not SQL execution duration. Inspect JDBC trace spans for queries.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(db_client_connections_wait_time_milliseconds_bucket{service_name=\"payment-service\"}[$__rate_interval]))) / 1000",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
