      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_thread_count{service_name=\"payment-service\"})",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
