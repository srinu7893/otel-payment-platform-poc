    {
      "title": "API operation request count",
      "type": "table",
      "description": "Estimated Prometheus counter increase in selected window, grouped by route template and method; excludes actuator. Not an audit count.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route,http_request_method) (increase(http_server_request_duration_seconds_count{service_name=\"payment-service\",http_route!~\".*actuator.*\",http_route=~\".+\"}[$__range]))",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
