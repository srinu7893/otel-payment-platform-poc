      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(http_client_request_duration_seconds_bucket{service_name=\"payment-service\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
