    {
      "title": "Readiness now (fresh probe)",
      "type": "stat",
      "description": "1 ready, 0 failed. Missing/stale is unknown. Direct probes every 10s while native monitor runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "poc_readiness_probe_success{service_name=\"payment-service\"} and (time()-poc_readiness_probe_last_run_timestamp_seconds{service_name=\"payment-service\"} < 30)",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 20,
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Observed readiness availability (selected window)",
      "type": "stat",
      "description": "Successful probe attempts / all completed attempts. Monitor outages are excluded, not successful; inspect monitor UP and freshness. Not a production SLA.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(poc_readiness_probe_successes_total{service_name=\"payment-service\"}[$__range]) / increase(poc_readiness_probe_attempts_total{service_name=\"payment-service\"}[$__range])",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
