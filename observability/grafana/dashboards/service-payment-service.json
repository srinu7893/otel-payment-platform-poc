        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"payment-service\"}",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
