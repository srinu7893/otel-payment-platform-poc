{
  "uid": "telemetry-pipeline",
  "title": "Telemetry pipeline health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Prometheus scrape targets",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tempo received spans / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tempo_distributor_spans_received_total[$__rate_interval]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "title": "Outbox retry attempts",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(poc_outbox_publish_attempts_total{outcome=\"failure\"}[$__range]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "title": "Alert state",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Service graph edges",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (client,server) (rate(traces_service_graph_request_total[$__rate_interval]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "title": "Outbox failure logs",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"payment-service\"} |= \"OUTBOX_PUBLISH_FAILED\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
