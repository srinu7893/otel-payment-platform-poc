{
  "uid": "payment-business",
  "title": "Business events and reconciliation",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Completed payment log events / 5 minutes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"payment-service\"} |= \"event=PAYMENT_COMPLETED\" [5m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Unknown outcomes / 5 minutes",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"payment-service\"} |= \"event=PAYMENT_RECONCILIATION_REQUIRED\" [5m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "title": "Business declines / 5 minutes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"payment-service\"} |= \"event=PAYMENT_NOT_COMPLETED\" [5m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "title": "Outbox attempts by outcome",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(poc_outbox_publish_attempts_total[$__range]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Notification activity",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"notification-service\"} |~ \"NOTIFICATION_(EVENT_RECEIVED|DUPLICATE_SKIPPED|RETRY_REUSED)\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "title": "Reconciliation and risk events",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"payment-service\"} |~ \"RECONCILIATION|RISK\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 7,
      "title": "Durable payment rows by current status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (poc_payment_records)",
          "legendFormat": "{{status}}{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Cached durable-state gauge; check snapshot freshness. Use max across replicas sharing the same database. Synthetic checks are on demand, not continuous availability."
    },
    {
      "id": 8,
      "title": "Durable notification rows by current status",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (poc_notification_records)",
          "legendFormat": "{{status}}{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Cached durable-state gauge; check snapshot freshness. Use max across replicas sharing the same database. Synthetic checks are on demand, not continuous availability."
    },
    {
      "id": 9,
      "title": "Oldest saved outbox work",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(poc_outbox_oldest_pending_seconds)",
          "legendFormat": "{{status}}{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Cached durable-state gauge; check snapshot freshness. Use max across replicas sharing the same database. Synthetic checks are on demand, not continuous availability."
    },
    {
      "id": 10,
      "title": "Oldest unsent notification record",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(poc_notification_oldest_unsent_seconds)",
          "legendFormat": "{{status}}{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Cached durable-state gauge; check snapshot freshness. Use max across replicas sharing the same database. Synthetic checks are on demand, not continuous availability."
    },
    {
      "id": 11,
      "title": "Business snapshot freshness",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service_name) (time() - poc_business_snapshot_last_success_timestamp_seconds)",
          "legendFormat": "{{status}}{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Cached durable-state gauge; check snapshot freshness. Use max across replicas sharing the same database. Synthetic checks are on demand, not continuous availability."
    },
    {
      "id": 12,
      "title": "Synthetic journey outcome (on demand)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "poc_synthetic_journey_success",
          "legendFormat": "{{status}}{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Cached durable-state gauge; check snapshot freshness. Use max across replicas sharing the same database. Synthetic checks are on demand, not continuous availability."
    }
  ]
}
