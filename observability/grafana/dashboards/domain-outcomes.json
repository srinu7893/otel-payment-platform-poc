{
  "uid": "domain-outcomes",
  "title": "Business operations \u2014 durable outcomes and delivery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "otel",
    "payment-poc",
    "overview"
  ],
  "links": [
    {
      "title": "All dashboards",
      "type": "dashboards",
      "tags": [
        "payment-poc"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Support runbook",
      "type": "link",
      "url": "https://github.com/srinu7893/otel-payment-platform-poc/blob/feature/otel-observability-manual-e2e/docs/DASHBOARDS_AND_DEPLOYMENT.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "title": "Current durable rows by operation/status",
      "type": "timeseries",
      "description": "Database state, not event counters. Includes payment, transfer and refund.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (operation,status) (poc_domain_records)",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Completed creation-cohort ratio",
      "type": "timeseries",
      "description": "Operations created between 60 and 2 minutes ago: current COMPLETED / all rows. Recent 2 minutes excluded for maturation; unresolved outcomes count against completion. Zero rows is unknown, not 100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (operation)(poc_domain_cohort_completed)/max by (operation)(poc_domain_cohort_records)",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Creation-cohort size",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (operation)(poc_domain_cohort_records)",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Event creation to notification SENT",
      "type": "timeseries",
      "description": "SQL p50/p95/p99 over records SENT in the last hour, joined to durable source outbox events; includes publishing/queue/consumer delay. Start is event creation in the commit transaction, not an exact database commit timestamp. Per delivery record/channel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (quantile)(poc_event_delivery_seconds)",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Delivered sample count (last hour)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(poc_event_delivery_records)",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Domain snapshot healthy",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(poc_domain_snapshot_healthy)",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Domain snapshot age",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time()-(poc_domain_snapshot_last_success_timestamp_seconds > 0))",
          "legendFormat": "{{service_name}} {{http_route}} {{status}} {{state}} {{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    }
  ]
}
