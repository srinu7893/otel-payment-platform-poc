    {
      "title": "Observed readiness availability by service",
      "type": "timeseries",
      "description": "Missing monitor intervals are unknown, not successful. Inspect monitor UP.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(poc_readiness_probe_successes_total[$__range])/increase(poc_readiness_probe_attempts_total[$__range])",
