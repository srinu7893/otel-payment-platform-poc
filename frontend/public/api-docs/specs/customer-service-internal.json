            "type": "string",
            "format": "date-time"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "cloudRunIdentity": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Serverless-Authorization",
        "description": "Bearer Google ID token with the selected private service canonical URL as audience; caller must have run.invoker. This is separate from the application JWT."
      }
    }
  }
