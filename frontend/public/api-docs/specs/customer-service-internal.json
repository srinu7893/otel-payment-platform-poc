{
  "openapi": "3.0.3",
  "info": {
    "title": "Payment platform \u2014 customer-service",
    "version": "1.1.0",
    "description": "Generated build-time contracts from controller handlers. Private catalogs document service-only endpoints; they are not public routes. Request/response execution evidence is produced separately by scripts/run-api-tests.cmd."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8084",
      "description": "Authenticated local proxy / native service; private contracts are not public gateway routes"
    }
  ],
  "paths": {
    "/internal/onboarding/customers/{id}": {
