              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected processing failure; use correlation/trace IDs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency or provisioning unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-source": "customer-service/src/main/java/com/srinu/otelpoc/customer/api/OnboardingController.java",
        "x-required-access": "Cloud Run invoker identity; trusted service/operator only",
        "x-private": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Demo Customer",
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "example": "demo@example.com",
                    "maxLength": 160,
                    "format": "email"
                  },
                  "accountNumber": {
                    "type": "string",
                    "example": "ACCAAAAAAAAAAAAAAAAAAAAAAAA",
                    "pattern": "ACC[A-F0-9]{24}"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "accountNumber"
                ]
              },
              "example": {
                "name": "Demo Customer",
                "email": "demo@example.com",
                "accountNumber": "ACCAAAAAAAAAAAAAAAAAAAAAAAA"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
