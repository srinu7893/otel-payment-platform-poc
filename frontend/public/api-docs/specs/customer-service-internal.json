        "operationId": "customer_service_put_internal_onboarding_customers_id",
        "tags": [
          "customer-service"
        ],
        "summary": "Provision \u2014 {id}",
        "description": "Cloud Run invoker identity; trusted service/operator only. Internal-only contract, not routed by the public API gateway. Browser execution is disabled in the private catalog. Source: customer-service/src/main/java/com/srinu/otelpoc/customer/api/OnboardingController.java",
        "security": [
          {
            "cloudRunIdentity": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "demo-customer"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; business outcome is in the returned status, if present.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Customer response; observed fields are in the execution report."
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid application or Cloud Run credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient role/ownership/invoker permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Record not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "405": {
            "description": "HTTP method not supported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "State or idempotency conflict",
