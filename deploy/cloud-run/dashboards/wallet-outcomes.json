{
  "displayName": "OTel Payment POC - wallet-outcomes",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 2,
        "widget": {
          "title": "How to investigate",
          "text": {
            "format": "MARKDOWN",
            "content": "OTel application metrics from Managed Prometheus. Grouped by service job, route template and HTTP method. Health routes are excluded. Request counts are Prometheus estimates, not ledger audit counts. Availability is HTTP technical availability; business declines and pending outcomes need transaction investigation. No traffic produces an undefined ratio, not 100% availability. Histograms require observations. Open a request in Postman Visualize or Support > Observability to follow its Logs and Trace links. A missing series is not zero. Wallet attempts include retries; committed deposit and request counts come from database rows. Snapshot health must be current. Browser measurements are bounded, untrusted and sampled by page lifecycle; mixed milliseconds and CLS score are grouped by unit."
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Wallet operation attempts per second",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by(operation,outcome)(rate(poc_wallet_operation_attempts_total{job=\"payment-poc/payment-service\"}[5m]))"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Wallet operation p95 processing seconds",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95,sum by(le,operation)(rate(poc_wallet_operation_duration_seconds_bucket{job=\"payment-poc/payment-service\"}[5m])))"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Committed unique deposits",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "max(poc_wallet_deposit_records{job=\"payment-poc/mock-bank-service\"})"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Committed deposit INR",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "max(poc_wallet_deposit_amount{job=\"payment-poc/mock-bank-service\"})"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 10,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Money requests by stored status",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "max by(status)(poc_money_request_records{job=\"payment-poc/payment-service\"})"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 10,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Deposit snapshot healthy",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "min(poc_wallet_snapshot_healthy{job=\"payment-poc/mock-bank-service\"})"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 14,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Request snapshot healthy",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "min(poc_money_request_snapshot_healthy{job=\"payment-poc/payment-service\"})"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
