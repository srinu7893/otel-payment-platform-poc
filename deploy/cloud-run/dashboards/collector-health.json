{
  "displayName": "OTel Payment POC - collector-health",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 2,
        "widget": {
          "title": "How to investigate",
          "text": {
            "format": "MARKDOWN",
            "content": "OTel application metrics from Managed Prometheus. Grouped by service job, route template and HTTP method. Health routes are excluded. Request counts are Prometheus estimates, not ledger audit counts. Availability is HTTP technical availability; business declines and pending outcomes need transaction investigation. No traffic produces an undefined ratio, not 100% availability. Histograms require observations. Open a request in Postman Visualize or Support > Observability to follow its Logs and Trace links. A missing series is not zero. Wallet attempts include retries; committed deposit and request counts come from database rows. Snapshot health must be current. Browser measurements are bounded, untrusted and sampled by page lifecycle; mixed milliseconds and CLS score are grouped by unit."
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Collector queue utilization",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "max by(exporter)(otelcol_exporter_queue_size{job=\"payment-poc/otelcol-cloud-run\"} / otelcol_exporter_queue_capacity{job=\"payment-poc/otelcol-cloud-run\"})"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Collector rejected spans",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(otelcol_receiver_refused_spans_total{job=\"payment-poc/otelcol-cloud-run\"}[5m])) or (0 * sum(rate(otelcol_receiver_accepted_spans_total{job=\"payment-poc/otelcol-cloud-run\"}[5m])))"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Collector failed span exports",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"payment-poc/otelcol-cloud-run\"}[5m])) or (0 * sum(rate(otelcol_exporter_sent_spans_total{job=\"payment-poc/otelcol-cloud-run\"}[5m])))"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Collector failed log exports",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"payment-poc/otelcol-cloud-run\"}[5m])) or (0 * sum(rate(otelcol_exporter_sent_log_records_total{job=\"payment-poc/otelcol-cloud-run\"}[5m])))"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}
