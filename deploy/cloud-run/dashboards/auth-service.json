                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (job,http_route,http_request_method) (increase(http_server_request_duration_seconds_count{job=\"payment-poc/auth-service\",http_route=~\".+\",http_route!~\".*actuator.*\"}[1h]))"
                },
                "plotType": "LINE"
              }
